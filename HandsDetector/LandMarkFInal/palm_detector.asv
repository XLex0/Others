
% Parámetros de configuración
score_threshold = 0.60;

[image, imageInput, image_height, image_width] = pre_process_palm('image/test4.jpg');

% lista de posibles cajas:
% score, box_x, box_y, box_size, kp0X, kp0Y, kp
boxes = process_palm(imageInput);


keep = boxes(:, 1) > score_threshold;
boxes = boxes(keep, :);

hands = [];

% Procesar cada detección
for i = 1:size(boxes, 1)

    box_x = boxes(i, 2);
    box_y = boxes(i, 3);
    box_size = boxes(i, 4);
    kp0_x = boxes(i, 5);
    kp0_y = boxes(i, 6);
    kp2_x = boxes(i, 7);
    kp2_y = boxes(i, 8);
    
    if box_size > 0
        % Solo dibujar los puntos clave (kp0 y kp2)
        % Dibujar el punto clave 0 (kp0)
        center0 = [kp0_x * image_width, kp0_y * image_height]; 
        image = insertShape(image, 'FilledCircle', [center0, 5], 'Color', 'red', 'LineWidth', 2);

        % Dibujar el punto clave 2 (kp2)
        center2 = [kp2_x * image_width, kp2_y * image_height]; 
        image = insertShape(image, 'FilledCircle', [center2, 5], 'Color', 'blue', 'LineWidth', 2);
    end
end

% Mostrar la imagen con las detecciones
imshow(image);
disp('Hands detected:');
disp(hands);
