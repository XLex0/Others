function [image] = draw_landmark(cut, xyz)
    
    [cap_height, cap_width, ~] = size(cut);

    num_images = numel(cut);

    
    for i = 1:num_images
     [cap_height, cap_width, ~] = size(cut(i));

     temp = xyz{i};

         for j = 1:21
             landmark = [temp(j,1)*cap_width, temp(j,2)*cap_height]
             cut{i} = draw_landmark(, landmarks);
         end

        
    end
end
